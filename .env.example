PORT=3000
NODE_ENV=development

# PostgreSQL (optional — falls back to in-memory storage when omitted)
# Pode usar DATABASE_URL (ex.: string do Supabase, decomposta automaticamente) OU as variáveis DB_* abaixo.
# DB_SSL aceita true/require/verify-full (Supabase exige SSL).
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=neurotree
DB_USER=neurotree_user
DB_PASSWORD=
DB_SSL=false

# Admin auth (login com senha + sessão JWT em cookie HttpOnly)
# Gere o hash com: node -e "console.log(require('bcrypt').hashSync('sua_senha', 12))"
ADMIN_PASSWORD_HASH=
# Segredo do JWT (mínimo 32 caracteres; gere com: openssl rand -hex 32)
JWT_SECRET=

# Rate limiting
RATE_LIMIT_POINTS=60
RATE_LIMIT_DURATION=60
